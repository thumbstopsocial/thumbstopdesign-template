# Every variable this site uses. Real values live only in Vercel env vars,
# set by the studio setup script. Never commit a real value.

# Resend: sending-only key restricted to the client's domain. re_dummy lets the site build and run locally.
RESEND_API_KEY=re_dummy
# Previews only: send every form submission here instead of the client (e.g. delivered@resend.dev).
RESEND_TEST_RECIPIENT=

# Upstash Redis: one shared database for all ThumbStop sites, keys prefixed by site.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/health. Vercel cron sends it automatically.
CRON_SECRET=

# Where health check failures are emailed (comma-separated).
THUMBSTOP_ALERT_EMAIL=

# Lets CI and the health check reach protected Vercel previews.
VERCEL_AUTOMATION_BYPASS_SECRET=
